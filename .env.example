# ─── Core ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://howmuch:howmuch@localhost:5432/howmuch

# Public base URL (no trailing slash). Used for share links, Stripe redirects, metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Auth (Auth.js) ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth (optional — the Google button only appears when both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email magic links (optional). Without EMAIL_SERVER, links are printed to the server log in development.
EMAIL_SERVER=
EMAIL_FROM="HOWMUCH? <play@example.com>"
# Comma-separated emails that are promoted to ADMIN on sign-in
ADMIN_EMAILS=
# Development-only instant sign-in by email (never active when NODE_ENV=production)
AUTH_DEV_LOGIN=false

# ─── Payments (Stripe, test mode) ────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# "stripe" (default when STRIPE_SECRET_KEY is set) or "mock" (local/testing only)
PAYMENTS_PROVIDER=

# ─── AI enrichment (optional) ────────────────────────────────────────────
AI_API_KEY=
AI_MODEL=claude-haiku-4-5

# ─── Analytics (optional) ────────────────────────────────────────────────
# Events are always stored in the database. Set a key to also forward to an external provider.
ANALYTICS_KEY=

# ─── Game tuning ─────────────────────────────────────────────────────────
# Free Quick Play games per UTC day (Daily, City and Country modes are always free)
FREE_QUICK_GAMES_PER_DAY=10
